<odoo>
    <!-- Wizard Form -->
    <record id="view_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">attendance.report.wizard.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Attendance Report Wizard">
                <group>
                    <group>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button string="Submit"
                            type="object"
                            name="action_generate_report"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Report Tree View -->
    <record id="view_attendance_report_line_tree" model="ir.ui.view">
        <field name="name">attendance.report.line.tree</field>
        <field name="model">attendance.report.line</field>
        <field name="arch" type="xml">
            <list string="Attendance Report" decoration-danger="is_highest_absent"
              decoration-success="is_highest_present" create="0">
                <field name="employee_id" width="200"/>
                <field name="present_days" width="120"/>
                <field name="absent_days" width="120"/>
                <field name="total_days" width="120"/>
            </list>
        </field>
    </record>

    <!-- Action for Wizard -->
    <record id="action_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Attendance Report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_attendance_report"
              name="Attendance Report"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_attendance_report_wizard"/>
</odoo>
