<odoo>

    <!-- CUSTOMER INVOICE / CREDIT NOTE (posted invoices) -->
    <template id="report_invoice_inherit"
              inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='payment_term']" position="after">
            <t t-call="tappy_accounts.bank_details_block"/>
        </xpath>
        <xpath expr="//div[p[@name='payment_communication']]" position="attributes">
            <attribute name="t-if">o.show_bank_details</attribute>
        </xpath>
    </template>

    <!-- REUSABLE BANK DETAILS BLOCK -->
    <template id="bank_details_block">
        <t t-if="o.show_bank_details">
            <div style="background:#f2f2f2; border-radius:10px; padding:10px 0 10px 15px;">
                <div style="text-align:center;">
                    <strong>Bank Details</strong><br/>
                </div>

                <t t-if="o.company_id.bank_ids">
                    <t t-set="b" t-value="o.company_id.bank_ids[0]"/>
                    <div style="margin-left:10px;"><strong>Bank Name:</strong> <span t-esc="b.bank_id.name"/></div>
                    <div style="margin-left:10px;"><strong>Account Number:</strong> <span t-esc="b.acc_number"/></div>
                    <div style="margin-left:10px;"><strong>IBAN No.:</strong> <span t-esc="b.bank_id.bic"/></div>
                </t>

                <t t-else="">
                    <div style="margin-left:10px;">No Bank Details Found</div>
                </t>
            </div>
        </t>
    </template>


</odoo>
