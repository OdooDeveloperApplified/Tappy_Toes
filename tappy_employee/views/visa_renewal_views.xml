    <!-- Menu under Employees -->
    <menuitem id="menu_visa_management"
              name="Renewals"
              parent="hr.menu_hr_root"
              />
    
    <menuitem id="menu_visa_renewal"
              name="Visa Renewal"
              parent="tappy_employee.menu_visa_management"
              action="action_visa_management"
              sequence="10"
              />
    
    <menuitem id="menu_work_permit_renewal"
              name="Work Permit Renewal"
