                <field name="passport_renewal_status" widget="badge" decoration-success="passport_renewal_status == 'active'" decoration-warning="passport_renewal_status =='expiring_soon'" decoration-danger="passport_renewal_status == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Action for Passport Management -->
