<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Visa management Tree View -->
    <record id="view_employee_visa_renewal_tree" model="ir.ui.view">
        <field name="name">employee.visa.renewal.tree</field>
        <field name="model">hr.employee</field>
        <field name="priority" eval="18"/> 
        <field name="arch" type="xml">
            <list string="Employee Visa Renewals" create="0">
                <field name="name"/>
                <field name="country_id"/>
                <field name="visa_no"/>
                <field name="visa_issue_date"/>
                <field name="visa_expire"/>
                <field name="visa_renewal_status" widget="badge" decoration-success="visa_renewal_status == 'active'" decoration-warning="visa_renewal_status =='expiring_soon'" decoration-danger="visa_renewal_status == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Action for Visa Management -->
    <record id="action_visa_management" model="ir.actions.act_window">
        <field name="name">Visa Renewal</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_employee_visa_renewal_tree"/>
         <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage Visa Renewals
            </p>
        </field>
    </record>


    <!-- Work Permit Renewal Tree View -->
    <record id="view_employee_work_permit_renewal_tree" model="ir.ui.view">
        <field name="name">employee.work.permit.renewal.tree</field>
        <field name="model">hr.employee</field>
        <field name="priority" eval="20"/> 
        <field name="arch" type="xml">
            <list string="Employee Work Permit Renewals" create="0">
                <field name="name"/>
                <field name="country_id"/>
                <field name="permit_no"/>
                <field name="work_permit_expiration_date"/>
                <field name="work_permit_status" widget="badge" decoration-success="work_permit_status == 'active'" decoration-warning="work_permit_status =='expiring_soon'" decoration-danger="work_permit_status == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Action for Visa Management -->
    <record id="action_work_permit_management" model="ir.actions.act_window">
        <field name="name">Work Permit Renewal</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_employee_work_permit_renewal_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage Work Permit Renewals
            </p>
        </field>
    </record>

