<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Complaint Tags Master Form View -->
    <record id="view_complaint_tags_form" model="ir.ui.view">
        <field name="name">complaint.tags.form</field>
        <field name="model">complaint.tags</field>
        <field name="arch" type="xml">
            <form string="Complaint Tags">
                <sheet>
                    <group>
                        <field name="complaint_tags"/>
                    </group>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Complaint Tags Master Tree View -->
    <record id="view_complaint_tags_tree" model="ir.ui.view">
        <field name="name">complaint.tags.tree</field>
        <field name="model">complaint.tags</field>
        <field name="arch" type="xml">
            <list>
                <field name="complaint_tags"/>
            </list>
        </field>
    </record>
  
    <!-- Complaint Tags Master Action -->
    <record id="action_complaint_tags_master" model="ir.actions.act_window">
        <field name="name">Complaint Tags</field>
        <field name="res_model">complaint.tags</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage Complaint Tags
            </p>
        </field>
    </record>

    <!-- Master Menu under Helpdesk > Configuration -->
    <menuitem id="menu_master_root"
              name="Master"
              parent="helpdesk.helpdesk_menu_config"
              sequence="40"
              />

    <!-- Complaint Tags Master sub-menu under Helpdesk > Configuration > Master -->
    <menuitem id="menu_complaint_tags_master"
              name="Complaint tags master"
              parent="tappy_helpdesk.menu_master_root"
              action="action_complaint_tags_master"
              sequence="10"
              />
</odoo>