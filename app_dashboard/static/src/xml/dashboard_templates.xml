<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
  <t t-name="ProfitLossDashboard">
    <div class="container-fluid my-3 px-4 dashboard-container position-relative">

      <!-- DASHBOARD OVERLAY LOADER -->
      <t t-if="state.isLoading">
        <div class="position-absolute w-100 h-100 top-0 start-0 d-flex flex-column align-items-center justify-content-center bg-view" 
             style="opacity: 0.85; z-index: 1050; border-radius: 1rem; backdrop-filter: blur(5px);">
          <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem; border-width: 0.25em;" role="status">
            <span class="visually-hidden"></span>
          </div>
          <h5 class="mt-3 fw-bold text-primary" style="letter-spacing: 0.5px;">Loading Financials...</h5>
        </div>
      </t>

      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start border-bottom bg-view dashboard-sticky-header">
        
        <div class="mb-3 mb-md-0">
          <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-graph-up-arrow"></i> Profit &amp; Loss Dashboard
          </h2>
          <small class="text-muted">Interactive financial summary by company</small>
        </div>

        <div class="d-flex flex-column align-items-md-end">
          
          <div class="bg-white p-1 rounded-pill border shadow-sm d-inline-flex align-items-center" style="font-size: 0.9rem;">
            
            <div class="position-relative">
              <button class="btn rounded-pill fw-bold border-0 m-0" 
                      t-att-style="state.currentFilter == 'month' ? 'background-color: #714B67; color: white; padding: 6px 20px;' : 'background: transparent; color: #4F5B69; padding: 6px 20px;'"
                      t-on-click="() => this.setFilter('month')">Month</button>
              
              <t t-if="state.currentFilter == 'month'">
                <div class="filter-navigator position-absolute top-100 start-50 translate-middle-x mt-2 bg-white p-1 rounded-pill border shadow-lg d-flex align-items-center justify-content-between" style="min-width: 200px; z-index: 1050;">
                  <button class="btn rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-light" style="width: 28px; height: 28px; padding: 0;" t-on-click="() => this.navigatePeriod(-1)">
                    <i class="bi bi-chevron-left" style="color: #714B67; font-size: 0.85rem; font-weight: 900;"></i>
                  </button>
                  <span class="fw-bold text-dark text-center flex-grow-1 px-2" style="font-size: 0.85rem; white-space: nowrap;">
                    <t t-esc="displayDateText"/>
                  </span>
                  <button class="btn rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-light" style="width: 28px; height: 28px; padding: 0;" t-on-click="() => this.navigatePeriod(1)">
                    <i class="bi bi-chevron-right" style="color: #714B67; font-size: 0.85rem; font-weight: 900;"></i>
                  </button>
                </div>
              </t>
            </div>
            
            <div class="position-relative">
              <button class="btn rounded-pill fw-bold border-0 m-0" 
                      t-att-style="state.currentFilter == 'quarter' ? 'background-color: #714B67; color: white; padding: 6px 20px;' : 'background: transparent; color: #4F5B69; padding: 6px 20px;'"
                      t-on-click="() => this.setFilter('quarter')">Quarter</button>
              
              <t t-if="state.currentFilter == 'quarter'">
                <div class="filter-navigator position-absolute top-100 start-50 translate-middle-x mt-2 bg-white p-1 rounded-pill border shadow-lg d-flex align-items-center justify-content-between" style="min-width: 200px; z-index: 1050;">
                  <button class="btn rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-light" style="width: 28px; height: 28px; padding: 0;" t-on-click="() => this.navigatePeriod(-1)">
                    <i class="bi bi-chevron-left" style="color: #714B67; font-size: 0.85rem; font-weight: 900;"></i>
                  </button>
                  <span class="fw-bold text-dark text-center flex-grow-1 px-2" style="font-size: 0.85rem; white-space: nowrap;">
                    <t t-esc="displayDateText"/>
                  </span>
                  <button class="btn rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-light" style="width: 28px; height: 28px; padding: 0;" t-on-click="() => this.navigatePeriod(1)">
                    <i class="bi bi-chevron-right" style="color: #714B67; font-size: 0.85rem; font-weight: 900;"></i>
                  </button>
                </div>
              </t>
            </div>

            <div class="position-relative">
              <button class="btn rounded-pill fw-bold border-0 m-0" 
                      t-att-style="state.currentFilter == 'year' ? 'background-color: #714B67; color: white; padding: 6px 20px;' : 'background: transparent; color: #4F5B69; padding: 6px 20px;'"
                      t-on-click="() => this.setFilter('year')">Year</button>
              
              <t t-if="state.currentFilter == 'year'">
                <div class="filter-navigator position-absolute top-100 start-50 translate-middle-x mt-2 bg-white p-1 rounded-pill border shadow-lg d-flex align-items-center justify-content-between" style="min-width: 200px; z-index: 1050;">
                  <button class="btn rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-light" style="width: 28px; height: 28px; padding: 0;" t-on-click="() => this.navigatePeriod(-1)">
                    <i class="bi bi-chevron-left" style="color: #714B67; font-size: 0.85rem; font-weight: 900;"></i>
                  </button>
                  <span class="fw-bold text-dark text-center flex-grow-1 px-2" style="font-size: 0.85rem; white-space: nowrap;">
                    <t t-esc="displayDateText"/>
                  </span>
                  <button class="btn rounded-circle d-flex align-items-center justify-content-center border-0 shadow-sm bg-light" style="width: 28px; height: 28px; padding: 0;" t-on-click="() => this.navigatePeriod(1)">
                    <i class="bi bi-chevron-right" style="color: #714B67; font-size: 0.85rem; font-weight: 900;"></i>
                  </button>
                </div>
              </t>
            </div>

            <div class="position-relative">
              <button class="btn rounded-pill fw-bold border-0 m-0" 
                      t-att-style="state.currentFilter == 'custom' ? 'background-color: #714B67; color: white; padding: 6px 20px;' : 'background: transparent; color: #4F5B69; padding: 6px 20px;'"
                      t-on-click="() => this.setFilter('custom')">Custom</button>
              
              <t t-if="state.currentFilter == 'custom'">
                <div class="position-absolute top-100 end-0 mt-2 bg-white p-2 rounded-3 border shadow-lg d-flex align-items-end gap-3 px-3 py-2" style="width: max-content; z-index: 1050;">
                  <div>
                    <label class="form-label text-muted fw-bold mb-1" style="font-size: 0.7rem;">From Date</label>
                    <DateTimeInput type="'date'" value="state.customFromDate" onChange="(date) => this.onCustomDateChange('customFromDate', date)" />
                  </div>
                  <div>
                    <label class="form-label text-muted fw-bold mb-1" style="font-size: 0.7rem;">To Date</label>
                    <DateTimeInput type="'date'" value="state.customToDate" onChange="(date) => this.onCustomDateChange('customToDate', date)" />
                  </div>
                </div>
              </t>
            </div>

            <div class="position-relative ms-1">
              <button class="btn rounded-pill fw-bold border-0 m-0 d-flex align-items-center gap-1"
                      t-att-style="state.compareYear ? 'background-color: #714B67; color: white; padding: 6px 16px;' : 'background: transparent; color: #4F5B69; padding: 6px 16px;'"
                      t-on-click="() => this.toggleCompareDropdown()">
                <i class="bi bi-arrow-left-right"></i>
                <t t-if="state.compareYear">Compare: <t t-esc="compareLabel"/></t>
                <t t-if="!state.compareYear">Compare Year</t>
              </button>

              <t t-if="state.showCompareDropdown">
                <div class="position-absolute top-100 end-0 mt-2 bg-white p-2 rounded-3 border shadow-lg" style="min-width: 170px; z-index: 1060;">
                  <t t-foreach="availableCompareYears" t-as="yr" t-key="yr">
                    <div class="dropdown-item rounded-2 px-2 py-1"
                         t-attf-style="cursor:pointer; #{yr === state.compareYear ? 'background-color:#f2e7f1; font-weight:700;' : ''}"
                         t-on-click="() => this.setCompareYear(yr)">
                      <t t-esc="yr"/>
                    </div>
                  </t>
                  <div class="d-flex align-items-center gap-1 mt-2 pt-2 border-top">
                    <input type="number" class="form-control form-control-sm" placeholder="Custom year"
                           t-on-change="(ev) => this.onCustomYearInput(ev)"/>
                  </div>
                  <t t-if="state.compareYear">
                    <div class="dropdown-item rounded-2 px-2 py-1 text-danger mt-2" style="cursor:pointer;" t-on-click="() => this.clearCompareYear()">
                      <i class="bi bi-x-circle"></i> Clear comparison
                    </div>
                  </t>
                </div>
              </t>
            </div>

          </div>
        </div>
      </div>

      <t t-if="companySections and companySections.length">
        <t t-foreach="companySections" t-as="company" t-key="company.name">
          <div class="company-section">
            <h4 class="mb-3 text-primary fw-bold">
              <i class="bi bi-building"></i> <t t-esc="company.name"/>
            </h4>

            <div class="row g-3">
              <t t-foreach="company.cards" t-as="card" t-key="card.title">
                <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                  <div t-attf-class="crm-card #{card.bg}">
                    <div class="top-row">
                      <span class="crm-title text-truncate"><t t-esc="card.title"/></span>
                      <div class="crm-icon">
                        <i t-attf-class="bi #{card.icon}"></i>
                      </div>
                    </div>
                    <div class="crm-value text-truncate w-100"><t t-esc="card.value"/></div>
                    <t t-if="card.compareValue">
                      <div class="text-truncate w-100" style="font-size: 1.05rem; font-weight: 500; opacity: 0.95;">
                        <span t-att-style="card.changePct !== null and card.changePct !== undefined ? (card.changePct >= 0 ? 'color:#bbf7d0;' : 'color:#fecaca;') : ''">
                          <t t-esc="card.compareValue"/>
                        </span>
                        <t t-if="card.changePct !== null and card.changePct !== undefined">
                          &#183;
                          <span t-att-style="card.changePct >= 0 ? 'color:#bbf7d0; font-weight:700;' : 'color:#fecaca; font-weight:700;'">
                            <t t-esc="(card.changePct >= 0 ? '+' : '') + card.changePct + '%'"/>
                          </span>
                        </t>
                      </div>
                    </t>
                  </div>
                </div>
              </t>
            </div>

            <div class="mt-4 p-3 shadow-sm bg-white rounded">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-secondary mb-0">
                  <i class="bi bi-bar-chart"></i> Visual Summary
                </h6>
                <div class="dropdown">
                  <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <t t-esc="(this.state.chartTypes[company.name] || 'bar').replace(/^./, c => c.toUpperCase())"/> Chart
                  </button>
                  <ul class="dropdown-menu">
                    <li><a class="dropdown-item" t-on-click="() => this.changeChartType(company.name, 'bar')">Bar</a></li>
                    <li><a class="dropdown-item" t-on-click="() => this.changeChartType(company.name, 'horizontalBar')">Horizontal Bar</a></li>
                    <li><a class="dropdown-item" t-on-click="() => this.changeChartType(company.name, 'pie')">Pie</a></li>
                  </ul>
                </div>
              </div>
              <canvas t-att-id="this.getSafeId(company.name)" height="150" style="width:100%; max-height:400px;"></canvas>
            </div>

            <div class="mt-4 p-3 shadow-sm bg-white rounded">
              <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-secondary mb-0">
                  <i class="bi bi-graph-up"></i> Month-Wise Account Trend
                </h6>
                <div class="d-flex gap-2">
                  <t t-if="state.compareYear">
                    <div class="dropdown">
                      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <t t-esc="(accountFilterList.find(m => m.key === state.trendCompareMetric) || accountFilterList[0]).label"/>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end">
                        <t t-foreach="accountFilterList" t-as="metric" t-key="metric.key">
                          <li><a class="dropdown-item" t-on-click="() => this.setTrendCompareMetric(metric.key)"><t t-esc="metric.label"/></a></li>
                        </t>
                      </ul>
                    </div>
                  </t>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      <t t-esc="(this.state.trendChartTypes[company.name] || 'line').replace(/^./, c => c.toUpperCase())"/> Chart
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><a class="dropdown-item" t-on-click="() => this.changeTrendChartType(company.name, 'line')">Line</a></li>
                      <li><a class="dropdown-item" t-on-click="() => this.changeTrendChartType(company.name, 'area')">Area</a></li>
                      <li><a class="dropdown-item" t-on-click="() => this.changeTrendChartType(company.name, 'bar')">Bar</a></li>
                    </ul>
                  </div>
                </div>
              </div>

              <canvas t-att-id="this.getTrendSafeId(company.name)" height="150" style="width:100%; max-height:400px;"></canvas>
            </div>
          </div>
        </t>
      </t>

      <t t-if="!(companySections and companySections.length)">
        <div class="alert alert-info text-center mt-5">
          No data available for the selected period.
        </div>
      </t>
    </div>
  </t>
</templates>