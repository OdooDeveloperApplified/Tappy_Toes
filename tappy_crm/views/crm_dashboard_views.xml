<odoo>
    <record id="view_crm_lead_pivot_stage_week" model="ir.ui.view">
        <field name="name">crm.lead.pivot.stage.week</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Pipeline by Stage and Week">
                <!-- Rows: Stages -->
                <field name="stage_display" type="row"/>
                

                <!-- Columns: Weeks -->
                <field name="create_date" type="col" interval="week"/>

                <!-- Values: Number of Leads -->
               
                
            </pivot>
        </field>
    </record>

    <!-- Action to open the Pivot -->
    <record id="action_crm_lead_pivot_stage_week" model="ir.actions.act_window">
        <field name="name">Pipeline by Stage/Week</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_crm_lead_pivot_stage_week"/>
        <field name="domain">[]</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_crm_lead_pivot_stage_week"
              name="Pipeline (Stage vs Week)"
              parent="crm.crm_menu_report"
              action="action_crm_lead_pivot_stage_week"
              sequence="50"/>
</odoo>
