<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Parent Concern Form View -->
    <record id="view_parent_concern_form" model="ir.ui.view">
        <field name="name">parent.concern.form</field>
        <field name="model">parent.concern</field>
        <field name="arch" type="xml">
            <form string="Parent Concern">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Parent Concern Tree View -->
    <record id="view_parent_concern_list" model="ir.ui.view">
        <field name="name">parent.concern.list</field>
        <field name="model">parent.concern</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    
    <!-- Parent Concern Action -->
    <record id="action_parent_concern" model="ir.actions.act_window">
        <field name="name">Parent Concerns</field>
        <field name="res_model">parent.concern</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage Parent Concerns.
            </p>
        </field>
    </record>

    <!-- Parent Concern Menu under CRM > Configuration > Master -->
    <menuitem id="menu_parent_concern"
              name="Parent Concerns"
              parent="tappy_crm.menu_crm_master_root"
              action="action_parent_concern"
              sequence="3"
              />
</odoo>