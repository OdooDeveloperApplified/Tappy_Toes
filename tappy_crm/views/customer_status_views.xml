<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Complaint Tags Master Form View -->
    <record id="view_customer_status_form" model="ir.ui.view">
        <field name="name">customer.status.form</field>
        <field name="model">customer.status</field>
        <field name="arch" type="xml">
            <form string="Customer Status">
                <sheet>
                    <group>
                        <field name="customer_status"/>
                    </group>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Complaint Tags Master Tree View -->
    <record id="view_customer_status_tree" model="ir.ui.view">
        <field name="name">customer.status.tree</field>
        <field name="model">customer.status</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_status"/>
            </list>
        </field>
    </record>
  
    <!-- Complaint Tags Master Action -->
    <record id="action_customer_status_master" model="ir.actions.act_window">
        <field name="name">Customer Status</field>
        <field name="res_model">customer.status</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage Customer Status
            </p>
        </field>
    </record>

    <!-- Master Menu under CRM > Configuration -->
    <menuitem id="menu_crm_master_root"
              name="Master"
              parent="crm.crm_menu_config"
              sequence="20"
              />

    <!-- Customer Status Menu under CRM > Configuration > Master -->
    <menuitem id="menu_customer_status"
              name="Customer Status"
              parent="tappy_crm.menu_crm_master_root"
              action="action_customer_status_master"
              sequence="2"
              />
</odoo>