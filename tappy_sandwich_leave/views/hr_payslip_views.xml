<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_sandwich_deduction" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.sandwich.deduction</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_id']" position="after">
                <field name="sandwich_occurrences" readonly="1"/>
                <field name="sandwich_deduction_amount" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
