<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="hr_salary_rule_sandwich_leave" model="hr.salary.rule">
            <field name="name">Sandwich Leave Deduction</field>
            <field name="sequence" eval="155"/>
            <field name="code">SANDWICHDED</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="struct_id" ref="l10n_ae_hr_payroll.uae_employee_payroll_structure"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.sandwich_occurrences > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -payslip.sandwich_deduction_amount</field>
        </record>
    </data>
</odoo>
