<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Record to add custom fields in Quotation form view -->
    <record id="view_hr_contract_template_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.template.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
           <xpath expr="//div[@name='l10n_ae_transportation_allowance']" position="after">
                <label for="telecommunication_allowance" invisible="country_code != 'AE'"/>
                    <div class="o_row" name="telecommunication_allowance" invisible="country_code != 'AE'">
                        <field name="telecommunication_allowance" nolabel="1"/>
                        <span>/ month</span>
                    </div>
            </xpath>
            <xpath expr="//field[@name='wage']" position="attributes">
                <attribute name="string">Basic Salary</attribute>
            </xpath>
        </field>
    </record> 

    <record id="view_hr_contract_tree_inherit_expiring" model="ir.ui.view">
        <field name="name">hr.contract.tree.inherit.expiring</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">state == 'expiring'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
