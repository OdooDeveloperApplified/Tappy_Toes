<odoo>
    <record id="ir_cron_license_expiry" model="ir.cron">
        <field name="name">License Expiry Reminder</field>
        <field name="model_id" ref="model_company_license"/>
        <field name="state">code</field>
        <field name="code">model._cron_license_expiry_notification()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
