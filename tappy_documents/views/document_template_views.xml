<odoo>

    <!-- TREE VIEW -->
    <record id="view_company_document_tree" model="ir.ui.view">
        <field name="name">company.document.tree</field>
        <field name="model">company.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="renewal_state == 'expired'"
                  decoration-warning="renewal_state == 'expiring'"
                  decoration-success="renewal_state == 'valid'">
                <field name="name"/>
                <field name="company_id"/>
                <field name="license_type"/>
                <field name="government_body"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="renewal_state"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_company_document_form" model="ir.ui.view">
        <field name="name">company.document.form</field>
        <field name="model">company.document</field>
        <field name="arch" type="xml">
            <form string="Company Document">
                <sheet>
                    <header>
                        <field name="renewal_state" widget="statusbar"
                               statusbar_visible="valid,expiring,expired"/>
                    </header>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="license_type"/>
                            <field name="government_body"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_company_document" model="ir.actions.act_window">
        <field name="name">Company Documents</field>
        <field name="res_model">company.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_company_document_root"
              name="Official Documents"
              parent="documents.dashboard"
              action="action_company_document"
              sequence="10"/>

</odoo>
